<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_login_history_list" model="ir.ui.view">
        <field name="name">login.history.list</field>
        <field name="model">login.history</field>
        <field name="arch" type="xml">
            <list string="Login Logs" create="0" edit="0" delete="0"
                  decoration-success="status == 'active'" decoration-muted="status == 'logout'">
                <field name="user_id"/>
                <field name="login_time"/>
                <field name="logout_time" optional="show"/>
                <field name="status" widget="badge"/>
                <field name="ip_address" string="IP"/>
                <field name="city" optional="show"/>
                <field name="country" optional="show"/>
                <field name="browser" optional="show"/>
                <field name="operating_system" string="OS" optional="show"/>
                <field name="duration" widget="float_time" optional="show"/>
                <field name="region" optional="hide"/>
                <field name="location_source" optional="hide"/>
                <field name="latitude" optional="hide"/>
                <field name="longitude" optional="hide"/>
                <field name="session_id" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="view_login_history_form" model="ir.ui.view">
        <field name="name">login.history.form</field>
        <field name="model">login.history</field>
        <field name="arch" type="xml">
            <form string="Login History" create="0" edit="0" delete="0">
                <header>
                    <button name="action_open_map" type="object" string="Open Map"
                            icon="fa-map-marker" class="btn-primary"
                            invisible="not latitude or not longitude"/>
                    <field name="status" widget="statusbar" statusbar_visible="active,logout"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="user_id" readonly="1"/></h1>
                    </div>
                    <group>
                        <group string="Session">
                            <field name="login_time"/>
                            <field name="logout_time"/>
                            <field name="duration" widget="float_time"/>
                            <field name="ip_address"/>
                        </group>
                        <group string="Device">
                            <field name="browser"/>
                            <field name="operating_system"/>
                            <field name="location_source"/>
                            <field name="full_location"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Location" name="location">
                            <group>
                                <group>
                                    <field name="city"/>
                                    <field name="region"/>
                                    <field name="country"/>
                                </group>
                                <group>
                                    <field name="latitude"/>
                                    <field name="longitude"/>
                                    <field name="map_url" widget="url"/>
                                </group>
                            </group>
                        </page>
                        <page string="Technical Details" name="technical_details">
                            <group>
                                <field name="session_id"/>
                                <field name="user_agent"/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_login_history_search" model="ir.ui.view">
        <field name="name">login.history.search</field>
        <field name="model">login.history</field>
        <field name="arch" type="xml">
            <search string="Login Logs">
                <field name="user_id"/>
                <field name="ip_address"/>
                <field name="city"/>
                <field name="country"/>
                <separator/>
                <filter name="active_sessions" string="Active" domain="[('status', '=', 'active')]"/>
                <filter name="logout_sessions" string="Logged Out" domain="[('status', '=', 'logout')]"/>
                <separator/>
                <filter name="browser_location" string="Browser Location" domain="[('location_source', '=', 'browser')]"/>
                <filter name="ip_location" string="IP Location" domain="[('location_source', '=', 'ip')]"/>
                <group>
                    <filter name="group_by_user" string="User" context="{'group_by': 'user_id'}"/>
                    <filter name="group_by_status" string="Status" context="{'group_by': 'status'}"/>
                    <filter name="group_by_country" string="Country" context="{'group_by': 'country'}"/>
                    <filter name="group_by_login_date" string="Login Date" context="{'group_by': 'login_time:day'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_login_history" model="ir.actions.act_window">
        <field name="name">Login Logs</field>
        <field name="res_model">login.history</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_login_history_search"/>
    </record>

    <record id="view_login_failed_history_list" model="ir.ui.view">
        <field name="name">login.failed.history.list</field>
        <field name="model">login.failed.history</field>
        <field name="arch" type="xml">
            <list string="Failed Login Logs" create="0" edit="0" delete="0" decoration-danger="True">
                <field name="login"/>
                <field name="attempt_time"/>
                <field name="reason"/>
                <field name="ip_address" string="IP"/>
                <field name="city" optional="show"/>
                <field name="country" optional="show"/>
                <field name="browser" optional="show"/>
                <field name="operating_system" string="OS" optional="show"/>
                <field name="region" optional="hide"/>
                <field name="location_source" optional="hide"/>
                <field name="latitude" optional="hide"/>
                <field name="longitude" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="view_login_failed_history_form" model="ir.ui.view">
        <field name="name">login.failed.history.form</field>
        <field name="model">login.failed.history</field>
        <field name="arch" type="xml">
            <form string="Failed Login Log" create="0" edit="0" delete="0">
                <header>
                    <button name="action_open_map" type="object" string="Open Map"
                            icon="fa-map-marker" class="btn-primary"
                            invisible="not latitude or not longitude"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="login" readonly="1"/></h1>
                    </div>
                    <group>
                        <group string="Attempt">
                            <field name="attempt_time"/>
                            <field name="reason"/>
                            <field name="ip_address"/>
                        </group>
                        <group string="Device">
                            <field name="browser"/>
                            <field name="operating_system"/>
                            <field name="location_source"/>
                            <field name="full_location"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Location" name="location">
                            <group>
                                <group>
                                    <field name="city"/>
                                    <field name="region"/>
                                    <field name="country"/>
                                </group>
                                <group>
                                    <field name="latitude"/>
                                    <field name="longitude"/>
                                    <field name="map_url" widget="url"/>
                                </group>
                            </group>
                        </page>
                        <page string="Technical Details" name="technical_details">
                            <field name="user_agent"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_login_failed_history_search" model="ir.ui.view">
        <field name="name">login.failed.history.search</field>
        <field name="model">login.failed.history</field>
        <field name="arch" type="xml">
            <search string="Failed Login Logs">
                <field name="login"/>
                <field name="ip_address"/>
                <field name="city"/>
                <field name="country"/>
                <field name="reason"/>
                <separator/>
                <filter name="browser_location" string="Browser Location" domain="[('location_source', '=', 'browser')]"/>
                <filter name="ip_location" string="IP Location" domain="[('location_source', '=', 'ip')]"/>
                <group>
                    <filter name="group_by_login" string="Login" context="{'group_by': 'login'}"/>
                    <filter name="group_by_country" string="Country" context="{'group_by': 'country'}"/>
                    <filter name="group_by_attempt_date" string="Attempt Date" context="{'group_by': 'attempt_time:day'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_login_failed_history" model="ir.actions.act_window">
        <field name="name">Failed Login Logs</field>
        <field name="res_model">login.failed.history</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_login_failed_history_search"/>
    </record>
</odoo>
