<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_mst_user_activity_log_list" model="ir.ui.view">
        <field name="name">mst.user.activity.log.list</field>
        <field name="model">mst.user.activity.log</field>
        <field name="arch" type="xml">
            <list string="Advanced Audit Logs" create="0" edit="0" delete="0"
                  decoration-success="action_type == 'create'"
                  decoration-info="action_type == 'modify'"
                  decoration-danger="action_type == 'delete'">
                <field name="performed_date"/>
                <field name="user_id"/>
                <field name="action_type" widget="badge"/>
                <field name="model_description" string="Model"/>
                <field name="name" string="Record"/>
                <field name="has_changes" optional="show"/>
                <field name="ip_address" string="IP" optional="show"/>
                <field name="browser" optional="hide"/>
                <field name="operating_system" string="OS" optional="hide"/>
                <field name="module_name" optional="hide"/>
                <field name="model_name" optional="hide"/>
                <field name="record_id" optional="hide"/>
                <field name="model_log_enabled" optional="hide"/>
                <field name="model_config_id" optional="hide"/>
                <field name="session_id" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="view_mst_user_activity_log_form" model="ir.ui.view">
        <field name="name">mst.user.activity.log.form</field>
        <field name="model">mst.user.activity.log</field>
        <field name="arch" type="xml">
            <form string="Audit Log" create="0" edit="0" delete="0">
                <header>
                    <button name="action_open_record" type="object" string="Open Record"
                            icon="fa-external-link" class="btn-primary"
                            invisible="not model_name or not record_id or action_type == 'delete'"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group string="Activity">
                            <field name="performed_date"/>
                            <field name="user_id"/>
                            <field name="login"/>
                            <field name="action_type" widget="badge"/>
                            <field name="has_changes"/>
                        </group>
                        <group string="Record">
                            <field name="model_description"/>
                            <field name="module_name"/>
                            <field name="model_name"/>
                            <field name="record_id"/>
                            <field name="model_config_id" invisible="not model_log_enabled"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Changes" name="changes">
                            <field name="line_ids" nolabel="1">
                                <list create="0" edit="0" delete="0">
                                    <field name="field_label" string="Field"/>
                                    <field name="old_value"/>
                                    <field name="new_value"/>
                                    <field name="field_name" optional="hide"/>
                                    <field name="is_view_field" optional="hide"/>
                                </list>
                            </field>
                        </page>
                        <page string="Request &amp; Device" name="technical">
                            <group>
                                <group string="Device">
                                    <field name="ip_address"/>
                                    <field name="browser"/>
                                    <field name="operating_system"/>
                                    <field name="session_id"/>
                                </group>
                                <group string="Request">
                                    <field name="request_method"/>
                                    <field name="request_url"/>
                                    <field name="model_log_enabled"/>
                                    <field name="has_view_changes"/>
                                </group>
                            </group>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_mst_user_activity_log_search" model="ir.ui.view">
        <field name="name">mst.user.activity.log.search</field>
        <field name="model">mst.user.activity.log</field>
        <field name="arch" type="xml">
            <search string="Advanced Audit Logs">
                <field name="user_id"/>
                <field name="action_type"/>
                <field name="model_description"/>
                <field name="name"/>
                <field name="ip_address"/>
                <separator/>
                <filter name="filter_create" string="Created" domain="[('action_type', '=', 'create')]"/>
                <filter name="filter_modify" string="Modified" domain="[('action_type', '=', 'modify')]"/>
                <filter name="filter_delete" string="Deleted" domain="[('action_type', '=', 'delete')]"/>
                <separator/>
                <filter name="filter_model_logs" string="Configured Models" domain="[('model_log_enabled', '=', True)]"/>
                <filter name="filter_with_changes" string="With Changes" domain="[('has_changes', '=', True)]"/>
                <group>
                    <filter name="group_user" string="User" context="{'group_by': 'user_id'}"/>
                    <filter name="group_action" string="Action" context="{'group_by': 'action_type'}"/>
                    <filter name="group_model" string="Model" context="{'group_by': 'model_description'}"/>
                    <filter name="group_date" string="Date" context="{'group_by': 'performed_date:day'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_mst_user_activity_log" model="ir.actions.act_window">
        <field name="name">Advanced Audit Logs</field>
        <field name="res_model">mst.user.activity.log</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_mst_user_activity_log_search"/>
    </record>

    <record id="action_mst_configured_model_activity_log" model="ir.actions.act_window">
        <field name="name">Model Audit Logs</field>
        <field name="res_model">mst.user.activity.log</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_mst_user_activity_log_search"/>
        <field name="domain">[('model_log_enabled','=',True)]</field>
        <field name="context">{'search_default_group_model': 1}</field>
    </record>

    <record id="view_users_form_activity_audit_inherit" model="ir.ui.view">
        <field name="name">res.users.form.activity.audit.inherit</field>
        <field name="model">res.users</field>
        <field name="inherit_id" ref="base.view_users_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <field name="active_session_count" invisible="1"/>
                <button name="action_kill_all_sessions" type="object"
                        string="Revoke Sessions" class="btn-danger"
                        confirm="Revoke all active Odoo sessions for this user?"
                        invisible="active_session_count == 0"
                        groups="base.group_system"/>
            </xpath>
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_view_login_history" type="object"
                        class="oe_stat_button" icon="fa-history"
                        groups="base.group_system">
                    <field name="login_history_count" widget="statinfo" string="Login Logs"/>
                </button>
                <button name="action_view_activity_logs" type="object"
                        class="oe_stat_button" icon="fa-list-alt"
                        groups="base.group_system">
                    <field name="activity_log_count" widget="statinfo" string="Audit Logs"/>
                </button>
            </xpath>
        </field>
    </record>
</odoo>
