<?xml version="1.0" encoding="UTF-8"?>

<templates xml:space="preserve">

    <t t-name="mst_dynamic_o2m_preview.DynamicOne2ManyPreview">
        <div class="o_dynamic_o2m_preview">

            <t t-if="this.state.loading">
                <span class="o_dynamic_o2m_empty">Loading...</span>
            </t>

            <t t-elif="!this.state.lines.length">
                <span class="o_dynamic_o2m_empty">No lines</span>
            </t>

            <t t-else="">
                <div class="o_dynamic_o2m_scroll">
                    <table class="o_dynamic_o2m_table"
                           t-att-style="'min-width:' + this.tableMinWidth">

                        <thead>
                            <tr>
                                <t t-foreach="this.columns"
                                   t-as="column"
                                   t-key="column.name">
                                    <th t-att-style="'width:' + this.cellWidth">
                                        <t t-out="column.label"/>
                                    </th>
                                </t>
                            </tr>
                        </thead>

                        <tbody>
                            <t t-foreach="this.state.lines"
                               t-as="line"
                               t-key="line.id">

                                <tr>
                                    <t t-foreach="this.columns"
                                       t-as="column"
                                       t-key="column.name">

                                        <td t-att-class="this.getCellClass(line, column)"
                                            t-att-title="this.getCellValue(line, column)"
                                            t-att-style="'width:' + this.cellWidth">
                                            <t t-out="this.getCellValue(line, column)"/>
                                        </td>

                                    </t>
                                </tr>

                            </t>
                        </tbody>

                    </table>
                </div>

                <t t-if="this.hasMoreRecords">
                    <div class="o_dynamic_o2m_more">
                        <t t-out="this.moreRecordsText"/>
                    </div>
                </t>
            </t>

        </div>
    </t>

</templates>