<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <template id="mst_mems_purchase_qweb_report.mst_qweb_report_epurchase_order_document">
            <t t-call="mst_mems_purchase_qweb_report.custom_purchase_order_qweb_external_layout">
                <t t-set="o" t-value="o.with_context({'lang':o.partner_id.lang})"/>
                <div class="page">
                    <style>

                        .header{
                        position: fixed;
                        top:0;
                        left:0;
                        right:0;
                        height:90px;
                        border-bottom:2px solid black;
                        }

                        .footer{
                        position: fixed;
                        bottom:0;
                        left:0;
                        right:0;
                        height:35px;
                        border-top:1px solid black;
                        font-size:12px;
                        }

                        .content{
                        margin-top:110px;
                        margin-bottom:50px;
                        }

                        .page-border{
                        border:2px solid black;
                        padding:20px;
                        margin:10px;
                        }

                    </style>


                    <!-- HEADER -->

                    <div style="width:30%; float:left;">
                        <img t-if="env.company.logo"
                             t-att-src="'data:image/png;base64,%s' % env.company.logo.decode('utf-8')"
                             style="max-height:50px;"/>
                    </div>

                    <div style="width:70%; float:right;">

                        <div style="float:right; text-align:left; font-size:14px; line-height:1.5; width:300px; margin-right:300px;">
                            <div>
                                <strong style="font-size:18px;">
                                    <t t-esc="env.company.name"/>
                                </strong>
                            </div>

                            <div>
                                <t t-esc="env.company.street or ''"/>
                                <t t-if="env.company.street2">
                                    ,
                                    <t t-esc="env.company.street2"/>
                                </t>
                            </div>

                            <div>
                                <t t-esc="env.company.city or ''"/>
                                <t t-if="env.company.state_id">
                                    ,
                                    <t t-esc="env.company.state_id.name"/>
                                </t>
                                <t t-if="env.company.zip">
                                    -
                                    <t t-esc="env.company.zip"/>
                                </t>
                            </div>

                            <div>
                                <t t-esc="env.company.country_id.name or ''"/>
                            </div>

                            <div t-if="env.company.phone">
                                Phone :
                                <t t-esc="env.company.phone"/>
                            </div>

                            <div t-if="env.company.email">
                                Email :
                                <t t-esc="env.company.email"/>
                            </div>

                        </div>

                    </div>

                    <div style="clear:both;"></div>

                    <div align="center" class="col-12"
                         style="padding:8px;border-top: 2px solid #8D8D8D;border-bottom: 2px solid #8D8D8D;border-left: 2px solid #8D8D8D;border-right: 2px solid #8D8D8D;">
                        <span style="font-family:Times;font-size:20px;">
                            <b>PURCHASE ORDER</b>
                        </span>
                    </div>

                    <div class="col-12" style="padding-left:8px;
						 		padding-right:8px;
						 		padding-top: 8px;border-bottom: 2px solid #8D8D8D;border-left: 2px solid #8D8D8D;border-right: 2px solid #8D8D8D;">
                        <div class="row col-12" style="padding-left:0px;">
                            <div class="col-3" style="font-family:Times;">Purchase Order No.</div>
                            <div class="col-9" style="font-family:Times;">
                                <b>:&#160;<span t-esc="o.name or '-'"/>
                                </b>
                            </div>
                        </div>
                        <div class="row col-12" style="padding-left:0px;">
                            <div class="col-3" style="font-family:Times;">Purchase Order Date.</div>
                            <div class="col-3">
                                <t t-if="o.date_approve"><b>:</b>&#160;<span style="font-family:Times;"
                                                                             t-esc="o.date_approve.strftime('%d.%m.%Y')"/>
                                </t>
                                <t t-if="not o.date_approve"><b>:</b>&#160;<span style="font-family:Times;"
                                                                                 t-esc="'-'"/>
                                </t>
                            </div>
                        </div>
                        <div class="row col-12" style="padding-left:0px;">
                            <div class="col-3" style="font-family:Times;">State</div>
                            <div class="col-2" style="font-family:Times;"><b>:</b>&#160;<span
                                    t-esc="o.company_id.partner_id.state_id.name or '-'"/>
                            </div>
                            <div class="col-2" style="font-family:Times;">State Code&#160;:</div>
                            <div class="col-1" align="center"
                                 style="border-left: 2px solid #8D8D8D;border-right: 2px solid #8D8D8D;border-top: 2px solid #8D8D8D;">
                                <span style="font-family:Times;" t-esc="o.company_id.partner_id.state_id.code or '-'"/>
                            </div>
                            <div class="col-4">
                                <font color="white">....</font>
                            </div>
                        </div>
                    </div>

                    <div class="col-12" style="padding-left:8px;
						 		padding-right:8px;
						 		padding-top: 8px;border-left: 2px solid #8D8D8D;border-right: 2px solid #8D8D8D;">
                        <div class="row col-12" style="padding-left:0px;">
                            <div class="col-3" style="font-family:Times;">Name</div>
                            <div class="col-5">
                                <b>
                                    <span style="font-family:Times;">:&#160;<t t-esc="o.partner_id.name or '-'"/>
                                    </span>
                                </b>
                            </div>
                            <div class="col-4">
                                <font color="white">....</font>
                            </div>
                        </div>
                        <div class="row col-12" style="padding-left:0px;">
                            <div class="col-3" style="font-family:Times;">Address</div>
                            <div class="col-9">
                                <b>:&#160;
                                    <t t-if="o.partner_id.street">
                                        <span style="font-family:Times;"><t t-esc="o.partner_id.street"/>,&#160;
                                        </span>
                                    </t>
                                    <t t-if="o.partner_id.street2">
                                        <span style="font-family:Times;"><t t-esc="o.partner_id.street2"/>,
                                        </span>
                                    </t>
                                    <br/>
                                    <t t-if="o.partner_id.city">
                                        <span style="font-family:Times;">&#160;&#160;<t t-esc="o.partner_id.city"/>
                                        </span>
                                    </t>
                                    <t t-if="o.partner_id.zip">
                                        <span style="font-family:Times;">&#160;-&#160;<t t-esc="o.partner_id.zip"/>,
                                        </span>
                                    </t>
                                    <br/>
                                    <t t-if="o.partner_id.state_id">
                                        <span style="font-family:Times;">&#160;&#160;<t
                                                t-esc="o.partner_id.state_id.name"/>,
                                        </span>
                                    </t>
                                    <t t-if="o.partner_id.country_id">
                                        <span style="font-family:Times;">&#160;<t t-esc="o.partner_id.country_id.name"/>
                                        </span>
                                    </t>
                                </b>
                            </div>
                        </div>
                        <div class="row col-12" style="padding-left:0px;">
                            <div class="col-3" style="font-family:Times;">TAXIN</div>
                            <div class="col-5">
                                <b>
                                    <span style="font-family:Times;">:&#160;<t t-esc="o.partner_id.vat or '-'"/>
                                    </span>
                                </b>

                            </div>
                            <div class="col-4">
                                <font color="white">....</font>
                            </div>
                        </div>
                        <div class="row col-12" style="padding-left:0px;">
                            <div class="col-3" style="font-family:Times;">State</div>
                            <div class="col-2" style="font-family:Times;">
                                <b>:&#160;<span t-esc="o.partner_id.state_id.name or '-'"/>
                                </b>
                            </div>
                            <div class="col-2" style="font-family:Times;">State Code&#160;:</div>
                            <div class="col-1" align="center"
                                 style="border-left: 2px solid #8D8D8D;border-right: 2px solid #8D8D8D;border-top: 2px solid #8D8D8D;">
                                <span style="font-family:Times;" t-esc="o.partner_id.state_id.code or '-'"/>
                            </div>
                            <div class="col-4">
                                <font color="white">....</font>
                            </div>
                        </div>
                    </div>

                    <table class="table table-bordered" style="border: 2px solid #8D8D8D;margin-bottom: 0px;">
                        <thead>
                            <tr style="border: 2px solid #8D8D8D;background-color:#E6F2FF;">
                                <th style="font-family:Times;width:4%;border: 2px solid #8D8D8D;text-align:center;">
                                    Sr.No
                                </th>
                                <th style="font-family:Times;width:35%;border: 2px solid #8D8D8D;text-align:center;">
                                    Name of Product/Service
                                </th>

                                <th style="font-family:Times;width:13%;border: 2px solid #8D8D8D;text-align:center;">
                                    QTY
                                </th>
                                <th style="font-family:Times;width:22%;border: 2px solid #8D8D8D;text-align:center;">
                                    Rate
                                </th>
                                <th style="font-family:Times;width:12%;border: 2px solid #8D8D8D;text-align:center;">
                                    Taxes
                                </th>
                                <th style="font-family:Times;width:17%;border: 2px solid #8D8D8D;text-align:center;">
                                    Amount
                                </th>
                            </tr>
                        </thead>
                        <tbody>
                            <t t-set="i" t-value="1"/>
                            <t t-set="uom_qty" t-value="0"/>
                            <t t-set="tot_val" t-value="0"/>
                            <tr style="border: 2px solid #8D8D8D;">
                            </tr>
                            <tr t-foreach="o.order_line" t-as="l" style="border: 2px solid #8D8D8D;">
                                <t t-if="not l.display_type == 'line_section' and not l.display_type == 'line_note'">
                                    <td align="center"
                                        style="font-family:Times;padding:3px;border: 2px solid #8D8D8D;border-bottom:2px solid #8D8D8D;border-top:hidden;">
                                        <span t-esc="i"/>
                                        <t t-set="i" t-value="i+1"/>
                                    </td>
                                    <td style="font-family:Times;padding:3px;border: 2px solid #8D8D8D;border-bottom:2px solid #8D8D8D;border-top:hidden;">
                                        <span t-field="l.name"/>
                                    </td>
                                    <td align="right"
                                        style="font-family:Times;padding:3px;border: 2px solid #8D8D8D;border-bottom:2px solid #8D8D8D;border-top:hidden;">
                                        <span t-field="l.product_qty"/>&#160;<span t-esc="l.product_uom.name"/>
                                    </td>
                                    <td align="right"
                                        style="font-family:Times;padding:3px;border: 2px solid #8D8D8D;border-bottom:2px solid #8D8D8D;border-top:hidden;">
                                        <span t-field="l.price_unit"/>&#160;/&#160;<span t-esc="l.product_uom.name"/>
                                    </td>
                                    <td align="center"
                                        style="font-family:Times;padding:3px;border: 2px solid #8D8D8D;border-bottom:2px solid #8D8D8D;border-top:hidden;">
                                        <span t-field="l.taxes_id.display_name"/>
                                    </td>
                                    <td align="right"
                                        style="font-family:Times;padding:3px;border: 2px solid #8D8D8D;border-bottom:2px solid #8D8D8D;border-top:hidden;">
                                        <span t-field="l.price_subtotal"/>
                                    </td>
                                    <t t-set="uom_qty" t-value="uom_qty+l.product_qty"/>
                                    <t t-set="tot_val" t-value="tot_val+l.price_subtotal"/>
                                </t>
                            </tr>
                            <tr style="border: 2px solid #8D8D8D;background-color:#E6F2FF;">
                                <th style="font-family:Times;width:4%;text-align:center;">

                                </th>
                                <th style="font-family:Times;width:35%;border: 2px solid #8D8D8D;text-align:center;">
                                Total
                                </th>
                                <th style="font-family:Times;width:13%;border: 2px solid #8D8D8D;text-align:center;">
                                   <b>
                                        <span t-esc="'%.2f' % uom_qty"/>
                                    </b>
                                </th>
                                <th style="font-family:Times;width:22%;border: 2px solid #8D8D8D;text-align:center;">

                                </th>
                                <th style="font-family:Times;width:12%;border: 2px solid #8D8D8D;text-align:center;">
                                </th>
                                <th style="font-family:Times;width:17%;border: 2px solid #8D8D8D;text-align:center;">
                                     <b>
                                        <span t-esc="tot_val"
                                              t-options="{'widget': 'monetary', 'display_currency': res_company.currency_id}"/>
                                    </b>
                                </th>
                            </tr>
                        </tbody>
                    </table>
                    <table class="table table-bordered"
                           style="border-top: hidden;border-bottom: 2px solid #8D8D8D;border-left: 2px solid #8D8D8D;border-right: 2px solid #8D8D8D;">
                        <tbody>

                            <tr style="border: 2px solid #8D8D8D;">
                                <td colspan="4" style="border-right: 2px solid #8D8D8D;">
                                    <span style="font-family:Times;">
                                        <b>Amount in Words:</b>
                                        <span t-esc="o.company_id.currency_id.amount_to_text(tot_val)"/>

                                    </span>
                                </td>
                                <td style="font-family:Times;border-right: hidden;">Total Amount Before Tax&#160;:</td>
                                <td style="font-family:Times;text-align:right;padding-right:3px;border-right: 2px solid #8D8D8D;">
                                    <b>
                                        <span t-field="o.amount_untaxed"/>
                                    </b>
                                </td>
                            </tr>
                            <t t-set="word" t-value="0"/>
                            <tr style="border: 2px solid #8D8D8D;padding-bottom:0px;">
                                <td colspan="2"
                                    style="border-right: 2px solid #8D8D8D;border-bottom:hidden;padding-bottom:0px;">
                                    <span style="font-family:Times;">
                                        <b>Terms and Conditions:&#160;</b>
                                    </span>
                                </td>
                                <td colspan="2"
                                    style="border-right: 2px solid #8D8D8D;border-bottom:hidden;padding-bottom:0px;">
                                    <span align="center"></span>
                                </td>
                                <td style="font-family:Times;border-right:hidden;border-bottom:hidden;padding-bottom:0px;">
                                    Tax Amount&#160;:
                                </td>
                                <td style="font-family:Times;text-align:right;padding-right:3px;border-bottom:hidden;border-right: 2px solid #8D8D8D;padding-bottom:0px;">
                                    <b>
                                        <span t-field="o.amount_tax"/>
                                    </b>
                                </td>
                            </tr>
                            <tr style="border: 2px solid #8D8D8D;padding-top:0px;">
                                <td colspan="2" style="border-right: 2px solid #8D8D8D;padding-top:0px;">

                                    <br/>
                                    <span style="font-family:Times;"></span>
                                    <br/>
                                    <span style="font-family:Times;"></span>
                                    <br/>
                                </td>
                                <td colspan="2"
                                    style="border-right: 2px solid #8D8D8D;border-bottom:hidden;padding-top:0px;">
                                    <span align="center"></span>
                                </td>
                                <td style="font-family:Times;border-right:hidden;padding-top:0px;">Total Amount After
                                    Tax&#160;:
                                </td>
                                <td style="font-family:Times;text-align:right;padding-right:3px;padding-top:0px;border-right: 2px solid #8D8D8D;">
                                    <b>
                                        <span t-field="o.amount_total"/>
                                    </b>
                                </td>
                            </tr>
                            <tr style="border: 2px solid #8D8D8D;">
                                <td colspan="2" style="border-right: 2px solid #8D8D8D;border-top:hidden;">
                                    <span style="font-family:Times;"></span>
                                    <br/>
                                    <span style="font-family:Times;" t-field="o.notes"/>

                                </td>
                                <td colspan="2" align="center"
                                    style="border-right: 2px solid #8D8D8D;border-top:hidden;">
                                    <br/>
                                    <span style="font-family:Times;">Seal</span>
                                </td>
                                <td colspan="2" style="border-right: 2px solid #8D8D8D;">
                                    <span style="font-family:Times;">Tax Payable on Reverse Charge:&#160;</span>
                                    <br/>
                                    <span style="font-family:Times;">Certified that the particulars given above are true
                                        and correct
                                    </span>
                                    <br/>
                                </td>
                            </tr>
                            <tr style="border: 2px solid #8D8D8D;">
                                <td colspan="2" align="center" style="border-right: 2px solid #8D8D8D;">
                                    <br/>
                                    <br/>
                                    <br/>
                                    <br/>
                                    <center>
                                        <b>
                                            <t t-esc="env.company.store_keeper"/>
                                        </b>
                                    </center>

                                    <span style="font-family:Times;">Store Keeper</span>

                                </td>
                                <td colspan="2" align="center"
                                    style="border-right: 2px solid #8D8D8D;border-top: 2px solid #8D8D8D;">
                                    <br/>
                                    <br/>
                                    <br/>
                                    <br/>
                                    <center>
                                        <b>
                                            <t t-esc="env.company.po_manager"/>
                                        </b>
                                    </center>
                                    <span style="font-family:Times;">Manager</span>
                                </td>
                                <td colspan="3">
                                    <center>
                                        <span style="font-family:Times;">
                                            <b>For,&#160;<t t-esc="o.company_id.name"/>
                                            </b>
                                        </span>
                                    </center>
                                    <br/>
                                    <br/>
                                    <br/>
                                    <br/>
                                    <center>
                                        <b>
                                            <t t-esc="env.company.managing_director"/>
                                        </b>
                                    </center>
                                    <center>
                                        <span style="font-family:Times;">Managing Director</span>
                                    </center>
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </t>
        </template>

        <template id="mst_qweb_report_epurchase_order">
            <t t-call="web.basic_layout">
                <t t-foreach="docs" t-as="o">
                    <t t-call="mst_mems_purchase_qweb_report.mst_qweb_report_epurchase_order_document"
                       t-lang="o.partner_id.lang"/>
                </t>
            </t>
        </template>

    </data>
</odoo>
