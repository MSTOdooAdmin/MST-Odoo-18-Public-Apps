<odoo>
    <record id="utm_source_view_form_prefix" model="ir.ui.view">
        <field name="name">utm.source.view.form.prefix</field>
        <field name="model">utm.source</field>
        <field name="inherit_id" ref="utm.utm_source_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="/form/sheet/group/field[@name='name']" position="after">
                <field name="lead_prefix"/>
            </xpath>
        </field>
    </record>

    <record id="utm_source_view_tree_prefix" model="ir.ui.view">
        <field name="name">utm.source.view.list.prefix</field>
        <field name="model">utm.source</field>
        <field name="inherit_id" ref="utm.utm_source_view_tree"/>
        <field name="arch" type="xml">
            <xpath expr="/list/field[@name='name']" position="after">
                <field name="lead_prefix"/>
            </xpath>
        </field>
    </record>
</odoo>
