<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
    
        <record id="paperformat_mst_sales_contract_qweb_reports" model="report.paperformat">
            <field name="name">MST MEMS Sales Order Summary Paper Format</field>
            <field name="default" eval="True"/>
	        <field name="format">A4</field>
	        <field name="orientation">Portrait</field>
	        <field name="margin_top">7</field>
	        <field name="margin_bottom">7</field>
	        <field name="margin_left">4</field>
	        <field name="margin_right">4</field>
	        <field name="header_line" eval="False"/>
	        <field name="header_spacing">37</field>
	        <field name="dpi">110</field>
        </record>

        <record id="action_mst_esales_contract_qweb_report" model="ir.actions.report">
            <field name="name">Sales Order Summary</field>
            <field name="model">sale.order</field>
            <field name="report_type">qweb-pdf</field>
            <field name="report_name">mst_mems_sales_qweb_report.mst_qweb_report_esales_contract</field>
            <field name="report_file">mst_mems_sales_qweb_report.mst_qweb_report_esales_contract</field>
            <field name="binding_model_id" ref="sale.model_sale_order"/>
            <field name="paperformat_id" ref="mst_mems_sales_qweb_report.paperformat_mst_sales_contract_qweb_reports"/>
            <field name="print_report_name">('Sale' + ' _ ' + ((object.name).replace('/','-')))</field>
            <field name="binding_type">report</field>
        </record>

    </data>
</odoo>
