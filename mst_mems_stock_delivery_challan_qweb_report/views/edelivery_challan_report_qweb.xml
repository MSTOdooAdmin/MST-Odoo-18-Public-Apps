<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <template id="mst_mems_stock_delivery_challan_qweb_report.mst_qweb_report_edelivery_challan_document">
            <t t-call="mst_mems_stock_delivery_challan_qweb_report.custom_delivery_challan_qweb_external_layout">
                <t t-set="o" t-value="o.with_context({'lang':o.partner_id.lang})"/>
                <div class="page">
                    <style>

                        .header{
                        position: fixed;
                        top:0;
                        left:0;
                        right:0;
                        height:90px;
                        border-bottom:2px solid black;
                        }

                        .footer{
                        position: fixed;
                        bottom:0;
                        left:0;
                        right:0;
                        height:35px;
                        border-top:1px solid black;
                        font-size:12px;
                        }

                        .content{
                        margin-top:110px;
                        margin-bottom:50px;
                        }

                        .page-border{
                        border:2px solid black;
                        padding:20px;
                        margin:10px;
                        }

                    </style>
                    <div style="width:30%; float:left;">
                        <img t-if="env.company.logo"
                             t-att-src="'data:image/png;base64,%s' % env.company.logo.decode('utf-8')"
                             style="max-height:50px;"/>
                    </div>

                    <div style="width:70%; float:right;">

                        <div style="float:right; text-align:left; font-size:14px; line-height:1.5; width:300px; margin-right:300px;">
                            <div>
                                <strong style="font-size:18px;">
                                    <t t-esc="env.company.name"/>
                                </strong>
                            </div>

                            <div>
                                <t t-esc="env.company.street or ''"/>
                                <t t-if="env.company.street2">
                                    ,
                                    <t t-esc="env.company.street2"/>
                                </t>
                            </div>

                            <div>
                                <t t-esc="env.company.city or ''"/>
                                <t t-if="env.company.state_id">
                                    ,
                                    <t t-esc="env.company.state_id.name"/>
                                </t>
                                <t t-if="env.company.zip">
                                    -
                                    <t t-esc="env.company.zip"/>
                                </t>
                            </div>

                            <div>
                                <t t-esc="env.company.country_id.name or ''"/>
                            </div>

                            <div t-if="env.company.phone">
                                Phone :
                                <t t-esc="env.company.phone"/>
                            </div>

                            <div t-if="env.company.email">
                                Email :
                                <t t-esc="env.company.email"/>
                            </div>

                        </div>

                    </div>
                    <div style="clear:both;"></div>
                    <table class="table table-bordered" style="border: 2px solid #8D8D8D;margin-bottom:0px;">
                        <tr style="border: 2px solid #8D8D8D;">
                            <td rowspan="3" align="center"
                                style="padding-top:28px;width:65%;font-size:25px;font-family:Times;font-weight:bold;border: 2px solid #8D8D8D;">
                                 DELIVERY CHALLAN
                            </td>
                            <td style="padding:3px;width:5%;border: 2px solid #8D8D8D;"></td>
                            <td style="padding:3px;width:30%;font-family:Times;border-bottom: hidden;">Original for
                                Consginee
                            </td>
                        </tr>
                        <tr>
                            <td style="padding:3px;width:5%;border: 2px solid #8D8D8D;"></td>
                            <td style="padding:3px;width:30%;font-family:Times;border-bottom: hidden;border-top: hidden;">
                                Duplicate for Transporter
                            </td>
                        </tr>
                        <tr>
                            <td style="padding:3px;width:5%;border: 2px solid #8D8D8D;"></td>
                            <td style="padding:3px;width:30%;font-family:Times;border-top: hidden;">Triplicate for
                                Consigner
                            </td>
                        </tr>
                    </table>

                    <div class="col-12" style="padding-left:8px;
											padding-right:8px;
											padding-top: 8px;border-bottom: 2px solid #8D8D8D;border-left: 2px solid #8D8D8D;border-right: 2px solid #8D8D8D;">
                        <div class="row col-12" style="padding-left:0px;">
                            <div class="col-3" style="font-family:Times;">Delivery Challan No</div>
                            <div class="col-3" style="font-family:Times;">
                                <b>:&#160;<span t-esc="o.name or '-'"/>
                                </b>
                            </div>
                        </div>
                        <div class="row col-12" style="padding-left:0px;">
                            <div class="col-3" style="font-family:Times;">Delivery Challan Date</div>
                            <div class="col-3">
                                <t t-if="o.scheduled_date"><b>:</b>&#160;<span style="font-family:Times;"
                                                                               t-esc="o.scheduled_date.strftime('%d.%m.%Y')"/>
                                </t>
                                <t t-if="not o.scheduled_date"><b>:</b>&#160;<span style="font-family:Times;"
                                                                                   t-esc="'-'"/>
                                </t>
                            </div>
                        </div>
                        <div class="row col-12" style="padding-left:0px;">
                            <div class="col-3" style="font-family:Times;">State</div>
                            <div class="col-2" style="font-family:Times;"><b>:</b>&#160;<span
                                    t-esc="o.company_id.partner_id.state_id.name or '-'"/>
                            </div>
                            <div class="col-2" style="font-family:Times;">State Code&#160;:</div>
                            <div class="col-1" align="center"
                                 style="border-left: 2px solid #8D8D8D;border-right: 2px solid #8D8D8D;border-top: 2px solid #8D8D8D;">
                                <span style="font-family:Times;" t-esc="o.company_id.partner_id.state_id.code or '-'"/>
                            </div>
                            <div class="col-4">
                                <font color="white">....</font>
                            </div>
                        </div>
                    </div>

                    <div class="col-12" style="padding-left:8px;
											padding-right:8px;
											padding-top: 8px;border-left: 2px solid #8D8D8D;border-right: 2px solid #8D8D8D;">

                        <div class="row col-12" style="padding-left:0px;">
                            <div class="col-3" style="font-family:Times;">Name</div>
                            <div class="col-9">
                                <b>
                                    <span style="font-family:Times;">:&#160;<t t-esc="o.partner_id.name or '-'"/>
                                    </span>
                                </b>
                            </div>

                        </div>
                        <div class="row col-12" style="padding-left:0px;">
                            <div class="col-3" style="font-family:Times;">Address</div>
                            <div class="col-9">:&#160;
                                <t t-if="o.partner_id.street">
                                    <span style="font-family:Times;"><t t-esc="o.partner_id.street"/>,&#160;
                                    </span>
                                </t>
                                <t t-if="o.partner_id.street2">
                                    <span style="font-family:Times;"><t t-esc="o.partner_id.street2"/>,
                                    </span>
                                </t>
                                <br/>
                                <t t-if="o.partner_id.city">
                                    <span style="font-family:Times;">&#160;&#160;<t t-esc="o.partner_id.city"/>
                                    </span>
                                </t>
                                <t t-if="o.partner_id.zip">
                                    <span style="font-family:Times;">&#160;-&#160;<t t-esc="o.partner_id.zip"/>,
                                    </span>
                                </t>
                                <br/>
                                <t t-if="o.partner_id.state_id">
                                    <span style="font-family:Times;">&#160;&#160;<t t-esc="o.partner_id.state_id.name"/>
                                        ,
                                    </span>
                                </t>
                                <t t-if="o.partner_id.country_id">
                                    <span style="font-family:Times;">&#160;<t t-esc="o.partner_id.country_id.name"/>
                                    </span>
                                </t>
                            </div>
                        </div>
                        <div class="row col-12" style="padding-left:0px;">
                            <div class="col-3" style="font-family:Times;">GSTIN</div>
                            <div class="col-5">
                                <b>
                                    <span style="font-family:Times;">:&#160;<t t-esc="o.partner_id.vat or '-'"/>
                                    </span>
                                </b>
                                <t t-if="o.partner_id.l10n_in_pan">
                                    &#160;&#160;&#160;PAN No :
                                    <span>
                                        <b>
                                            <t t-esc="o.partner_id.l10n_in_pan"/>
                                        </b>
                                    </span>
                                </t>
                            </div>
                            <div class="col-4">
                                <font color="white">....</font>
                            </div>
                        </div>
                        <div class="row col-12" style="padding-left:0px;">
                            <div class="col-3" style="font-family:Times;">State</div>
                            <div class="col-2" style="font-family:Times;">:&#160;<span
                                    t-esc="o.partner_id.state_id.name or '-'"/>
                            </div>
                            <div class="col-2" style="font-family:Times;">State Code&#160;:</div>
                            <div class="col-1" align="center"
                                 style="border-left: 2px solid #8D8D8D;border-right: 2px solid #8D8D8D;border-top: 2px solid #8D8D8D;">
                                <span style="font-family:Times;" t-esc="o.partner_id.state_id.code or '-'"/>
                            </div>
                            <div class="col-4">
                                <font color="white">....</font>
                            </div>
                        </div>
                    </div>

                    <table class="table table-bordered" style="border: 2px solid #8D8D8D;margin-bottom:0px;">
                        <thead>
                            <tr style="border: 2px solid #8D8D8D;background-color:#d2d4d6;">
                                <th style="font-family:Times;width:4%;border: 2px solid #8D8D8D;text-align:center;">
                                    Sr.No
                                </th>
                                <th style="font-family:Times;width:32%;border: 2px solid #8D8D8D;text-align:center;">
                                    Name of Product/Service
                                </th>
                                <th style="font-family:Times;width:12%;border: 2px solid #8D8D8D;text-align:center;">
                                    HSN
                                </th>
                                <th style="font-family:Times;width:15%;border: 2px solid #8D8D8D;text-align:center;">
                                    QTY
                                </th>
                                <th style="font-family:Times;width:15%;border: 2px solid #8D8D8D;text-align:center;">
                                    UOM
                                </th>
                                <th style="font-family:Times;width:22%;border: 2px solid #8D8D8D;text-align:center;">
                                    Amount
                                </th>
                            </tr>
                        </thead>
                        <tbody>
                            <t t-set="i" t-value="1"/>
                            <t t-set="tot_val" t-value="0.00"/>
                            <tr t-foreach="o.move_ids_without_package" t-as="l" style="border: 2px solid #8D8D8D;">
                                <td align="center"
                                    style="font-family:Times;padding:3px;border: 2px solid #8D8D8D;border-bottom:hidden;">
                                    <span t-esc="i"/>
                                    <t t-set="i" t-value="i+1"/>
                                </td>
                                <td style="font-family:Times;padding:3px;border: 2px solid #8D8D8D;border-bottom:hidden;">
                                    <span t-esc="l.product_id.display_name"/>
                                </td>
                                <td align="center"
                                    style="font-family:Times;padding:3px;border: 2px solid #8D8D8D;border-bottom:hidden;">
                                    <span t-field="l.product_id.l10n_in_hsn_code"/>
                                </td>
                                <td align="right"
                                    style="font-family:Times;padding:3px;border: 2px solid #8D8D8D;border-bottom:hidden;">
                                    <span t-field="l.quantity"/>
                                </td>
                                <td align="center"
                                    style="font-family:Times;padding:3px;border: 2px solid #8D8D8D;border-bottom:hidden;">
                                    <span t-esc="l.product_uom.name"/>
                                </td>
                                <td align="right"
                                    style="font-family:Times;padding:3px;border: 2px solid #8D8D8D;border-bottom:hidden;">
                                    <span t-esc="(l.product_id.lst_price * l.quantity)"
                                          t-options="{'widget': 'monetary', 'display_currency': res_company.currency_id}"/>
                                </td>
                                <t t-set="tot_val" t-value="tot_val + (l.product_id.lst_price * l.quantity)"/>
                            </tr>
                            <tr style="border: 2px solid #8D8D8D;">
                            </tr>
                            <tr style="border: 2px solid #8D8D8D;background-color:#d2d4d6;">
                                <td align="center" style="padding:3px;border: 2px solid #8D8D8D;"></td>
                                <td style="font-family:Times;padding:3px;border: 2px solid #8D8D8D;text-align:center;">
                                    <b>Total</b>
                                </td>
                                <td align="center" style="padding:3px;border: 2px solid #8D8D8D;"></td>
                                <td align="center"
                                    style="font-family:Times;padding:3px;border: 2px solid #8D8D8D;"></td>
                                <td align="center"
                                    style="font-family:Times;padding:3px;border: 2px solid #8D8D8D;"></td>
                                <td align="right" style="font-family:Times;padding:3px;border: 2px solid #8D8D8D;">
                                    <b>
                                        <span t-esc="tot_val"
                                              t-options="{'widget': 'monetary', 'display_currency': res_company.currency_id}"/>
                                    </b>
                                </td>
                            </tr>
                        </tbody>
                    </table>
                    <div class="col-12" style="border-left: 2px solid #8D8D8D;border-right: 2px solid #8D8D8D;">
                        <br/>
                    </div>
                    <div class="col-12" style="padding-left:8px;
											padding-right:8px;
											padding-top: 8px;border: 2px solid #8D8D8D;">

                        <span style="font-family:Times;">
                            <b>Amount in Words:</b>
                            <span t-esc="o.company_id.currency_id.amount_to_text(tot_val)"/>

                        </span>
                    </div>

                    <div class="col-12"
                         style="border-right: 2px solid #8D8D8D;border-left: 2px solid #8D8D8D;border-bottom: 2px solid #8D8D8D;">
                        <div class="row col-12" style="padding-left:0px;">

                            <!-- NOTES -->
                            <div class="col-5" style="border-right: 2px solid #8D8D8D;">
                                <span style="font-family:Times;">
                                    <center>
                                        <b>Notes</b>
                                    </center>
                                </span>
                                <span style="font-family:Times;">
                                    <span t-field="o.note"/>
                                </span>
                            </div>

                            <div class="col-3 text-center" style="border-right: 2px solid #8D8D8D;">

                                <div style="height:120px; display:flex; flex-direction:column; align-items:center; justify-content:center;">

                                    <!-- Image Wrapper -->
                                    <div style="height:85px; display:flex;margin-top:20px;justify-content:center;">
                                        <t t-if="o.company_id.delivery_challan_seal">
                                            <img t-att-src="'data:image/png;base64,%s' % o.company_id.delivery_challan_seal.decode('utf-8')"
                                                 style="max-height:70px; max-width:90px;"/>
                                        </t>
                                    </div>

                                    <!-- Text always below -->
                                    <div style="margin-top:100px;">
                                        <span style="font-family:Times;">Seal</span>
                                    </div>

                                </div>

                            </div>
                            <div class="col-4 text-center" style="padding:10px;">

                                <span style="font-family:Times;">
                                    Certified that the particulars given above are true and correct
                                </span>

                                <br/>
                                <br/>

                                <span style="font-family:Times;">
                                    <b>For,&#160;<t t-esc="o.company_id.name"/>
                                    </b>
                                </span>
                                <br/>
                                <br/>
                                <br/>

                                <t t-if="o.company_id.delivery_challan_sign">
                                    <span style="font-family:Times;">
                                        <b>
                                            <t t-esc="o.company_id.delivery_challan_sign"/>
                                        </b>
                                    </span>
                                </t>


                                <hr style="width:70%; margin:auto; margin-top:5px;"/>

                                <span style="font-family:Times;">
                                    Authorised Signatory
                                </span>

                            </div>

                        </div>
                    </div>
                </div>
            </t>
        </template>

        <template id="mst_qweb_report_edelivery_challan">
            <t t-call="web.html_container">
                <t t-call="web.basic_layout">
                    <t t-foreach="docs" t-as="o">
                        <t t-call="mst_mems_stock_delivery_challan_qweb_report.mst_qweb_report_edelivery_challan_document"
                           t-lang="o.partner_id.lang"/>
                    </t>
                </t>
            </t>
        </template>
    </data>
</odoo>
